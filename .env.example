# This file documents the env vars the project needs.
# Values are not stored here — they come from a 1Password Environment
# mounted at ./.env (see https://developer.1password.com/docs/environments/local-env-file).
#
# Each line below names an env var the application reads. To onboard,
# add a matching field to the 1Password Environment item that feeds this mount.

# Add var names below, one per line, e.g.:
# DATABASE_URL=
# API_KEY=

# TRMNL MCP API key. TRMNL issues these per plugin, so a second plugin
# in this repo would need its own variable, not a shared one.
TRMNL_MET_NORWAY_MCP_API_KEY=

# TRMNL_API_KEY is deliberately NOT here. Do not add it.
#
# It is an account key: it reads and writes every private plugin on the
# account, so it has a wider scope than this Environment, which holds the
# secrets of one plugin. Putting it here would copy an account-wide key into
# every plugin repo — many places to rotate, and a key readable by everything
# in each of them.
#
# `bin/push` reads it from one canonical 1Password item instead, through
# TRMNL_API_KEY_REF. See docs/development.md.
