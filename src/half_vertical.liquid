{%- comment -%}
  Half vertical, 400x480: a narrow column, about 368px of content height.

  Stacked, never side by side. What the full screen shows in a row, this shows
  in a column. Cut against the full screen:
    - the warning area name. The place is the user's own, so the area adds
      little, and names like "Loppa - Slettnes lighthouse" cannot fit 400px.
    - the hour strip drops from six columns to four, so eight hours, not twelve.
    - the day band drops from five columns to rows: five of them normally, four
      when a warning takes the top of the screen.
    - the place name moves to the title bar, which has room the hero does not.
{%- endcomment -%}

{%- comment -%} When no warning is issued, the band's space becomes forecast
     detail rather than empty gap: a fifth day. This is what #13 asked for. {%- endcomment -%}
{%- assign day_limit = 5 -%}
{%- if warn_count > 0 or warnings_ok == false -%}{%- assign day_limit = 4 -%}{%- endif -%}

{% if forecast_ok == false %}
  <div class="layout layout--col layout--center">
    <span class="value value--medium">No forecast data</span>
    <span class="label label--small text--center">MET Norway did not answer the last poll</span>
  </div>
{% else %}
  <div class="layout layout--col gap--space-between">

    {% if warn_count > 0 %}
      <div class="flex flex--row flex--center-y gap--small bg--black px--2 py--1">
        <span class="title title--small text--white text--uppercase">&#9888; {{ warn_level }}</span>
        <span class="label label--small text--white" data-clamp="1">{{ warn_event }}</span>
        {% if warn_count > 1 %}
          <div class="grow"></div>
          <span class="label label--small text--white">+{{ warn_count | minus: 1 }}</span>
        {% endif %}
      </div>
    {% elsif warnings_ok == false %}
      <div class="flex flex--row flex--center-x">
        <span class="label label--small label--outline">Warnings unavailable</span>
      </div>
    {% endif %}

    {%- comment -%} Hero. {%- endcomment -%}
    <div class="flex flex--col flex--center-x gap--none">
      <div class="flex flex--row flex--center-y gap">
        {% render "weather_icon", code: now_symbol, box: "w--[80px] h--[80px]" %}
        <span class="value value--xlarge value--tnums" data-fit-value="true">{{ now_temp | round: 0 }}&deg;</span>
      </div>
      <span class="label label--small">Feels like {{ now_feels | round: 0 }}&deg; &middot; {{ now_wind | round: 0 }} m/s {{ now_dir }}</span>
    </div>

    <div class="divider"></div>

    {%- comment -%} The next eight hours. {%- endcomment -%}
    <div class="grid grid--cols-4">
      {% for record in hour_list limit: 4 %}
        {% assign hour = record | split: "|" %}
        <div class="flex flex--col flex--center-x gap--none">
          <span class="label label--xsmall">{{ hour[0] | times: 1 | date: "%H" }}</span>
          {% render "weather_icon", code: hour[2], box: "w--[36px] h--[36px]" %}
          <span class="value value--xsmall value--tnums">{{ hour[1] }}&deg;</span>
          <span class="label label--xsmall">{% if hour[3] %}{{ hour[3] }}{{ hour[4] }}{% else %}&nbsp;{% endif %}</span>
        </div>
      {% endfor %}
    </div>

    <div class="divider"></div>

    {%- comment -%} The next four days, as rows: the shape is tall, not wide. {%- endcomment -%}
    <div class="flex flex--col gap--small stretch-x">
      {% for record in day_list limit: day_limit %}
        {% assign day = record | split: "|" %}
        <div class="flex flex--row flex--center-y gap w--full">
          <span class="label label--small text--uppercase w--[56px]">{% if forloop.first %}Today{% else %}{{ day[0] | times: 1 | date: "%a" }}{% endif %}</span>
          {% render "weather_icon", code: day[3], box: "w--[28px] h--[28px]" %}
          <div class="grow"></div>
          <span class="value value--xsmall value--tnums">{{ day[1] | round: 0 }}&deg; / {{ day[2] | round: 0 }}&deg;</span>
        </div>
      {% endfor %}
    </div>

  </div>
{% endif %}

<div class="title_bar">
  <span class="title">{{ place | default: "Forecast" }}</span>
  <span class="instance">MET Norway &middot; CC BY 4.0</span>
</div>
