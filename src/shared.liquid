{%- comment -%} 2. symbol_code -> glyph. MET builds every code from the same words,
     so the words decide the glyph and no 88-line table is needed.

     The rules cover all 88 codes MET issues today. A code MET adds later that
     matches none of these words falls back to wi-cloudy on purpose: a cloud is
     the least wrong picture of unknown weather, and a missing glyph would leave
     a hole in the strip. Add a rule above when a new family appears; do not
     change the fallback. {%- endcomment -%}
{% template weather_icon %}
  {%- assign night = false -%}
  {%- if code contains "_night" or code contains "polartwilight" -%}{%- assign night = true -%}{%- endif -%}
  {%- assign glyph = "wi-cloudy" -%}
  {%- if code contains "thunder" -%}
    {%- assign glyph = "wi-day-thunderstorm" -%}
    {%- if night -%}{%- assign glyph = "wi-thunderstorm" -%}{%- endif -%}
  {%- elsif code contains "snow" -%}
    {%- assign glyph = "wi-day-snow" -%}
    {%- if night -%}{%- assign glyph = "wi-snow" -%}{%- endif -%}
  {%- elsif code contains "sleet" -%}
    {%- assign glyph = "wi-day-sleet" -%}
    {%- if night -%}{%- assign glyph = "wi-sleet" -%}{%- endif -%}
  {%- elsif code contains "showers" -%}
    {%- assign glyph = "wi-day-rain" -%}
    {%- if night -%}{%- assign glyph = "wi-night-alt-rain" -%}{%- endif -%}
  {%- elsif code contains "rain" -%}
    {%- assign glyph = "wi-rain" -%}
  {%- elsif code contains "fog" -%}
    {%- assign glyph = "wi-day-fog" -%}
    {%- if night -%}{%- assign glyph = "wi-fog" -%}{%- endif -%}
  {%- elsif code contains "partlycloudy" -%}
    {%- assign glyph = "wi-day-cloudy" -%}
    {%- if night -%}{%- assign glyph = "wi-night-alt-cloudy" -%}{%- endif -%}
  {%- elsif code contains "fair" -%}
    {%- assign glyph = "wi-day-sunny-overcast" -%}
    {%- if night -%}{%- assign glyph = "wi-night-alt-cloudy" -%}{%- endif -%}
  {%- elsif code contains "clearsky" -%}
    {%- assign glyph = "wi-day-sunny" -%}
    {%- if night -%}{%- assign glyph = "wi-night-clear" -%}{%- endif -%}
  {%- endif -%}
  <svg class="{{ box }}"><use href="#{{ glyph }}"></use></svg>
{% endtemplate %}

{%- comment -%} 3. Poll health. A forecast with no series failed. A warnings poll that
     answers gives lastChange even when it gives no warning, so lastChange separates
     calm weather from a failed poll. {%- endcomment -%}
{%- assign series = IDX_0.properties.timeseries -%}
{%- assign forecast_ok = false -%}
{%- if series != nil and series.size > 0 -%}{%- assign forecast_ok = true -%}{%- endif -%}
{%- assign warnings_ok = false -%}
{%- if IDX_1.lastChange -%}{%- assign warnings_ok = true -%}{%- endif -%}

{%- comment -%} trmnl.user.utc_offset is a number of seconds, so adding it to an
     epoch and formatting the result gives the reader's local time. This is
     TRMNL's own documented idiom, not arithmetic of ours:
       {{ timestamp | date: "%s" | plus: trmnl.user.utc_offset | date: "%R" }}
     Every local time below is built this way. Verified against a jq derivation
     of the same payload at UTC+3. {%- endcomment -%}
{%- assign tz = trmnl.user.utc_offset -%}
{%- assign place = trmnl.plugin_settings.custom_fields_values.location_name -%}

{%- comment -%} 4. Warnings. Show the most severe, and count the rest. {%- endcomment -%}
{%- assign warn_count = 0 -%}
{%- assign warn_rank = 0 -%}
{%- assign warn_onset = 0 -%}
{%- assign warn_level = "" -%}
{%- assign warn_event = "" -%}
{%- assign warn_area = "" -%}
{%- if warnings_ok -%}
  {%- assign warn_count = IDX_1.features | size -%}
  {%- for feature in IDX_1.features -%}
    {%- assign colour = feature.properties.riskMatrixColor | downcase -%}
    {%- assign rank = 1 -%}
    {%- if colour == "orange" -%}{%- assign rank = 2 -%}{%- endif -%}
    {%- if colour == "red" -%}{%- assign rank = 3 -%}{%- endif -%}
    {%- comment -%} Severity first, then the earliest onset. A warning with no
         interval loses every tie rather than winning it by accident. {%- endcomment -%}
    {%- assign onset = 99999999999 -%}
    {%- if feature.when.interval[0] -%}
      {%- assign onset = feature.when.interval[0] | date: "%s" | times: 1 -%}
    {%- endif -%}
    {%- assign take = false -%}
    {%- if rank > warn_rank -%}
      {%- assign take = true -%}
    {%- elsif rank == warn_rank and onset < warn_onset -%}
      {%- assign take = true -%}
    {%- endif -%}
    {%- if take -%}
      {%- assign warn_rank = rank -%}
      {%- assign warn_onset = onset -%}
      {%- assign warn_level = colour | upcase -%}
      {%- assign warn_event = feature.properties.eventAwarenessName -%}
      {%- assign warn_area = feature.properties.area -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} 5. Now. {%- endcomment -%}
{%- if forecast_ok -%}
  {%- assign now = series[0] -%}
  {%- assign now_temp = now.data.instant.details.air_temperature -%}
  {%- assign now_feels = now.data.instant.details.apparent_air_temperature -%}
  {%- assign now_wind = now.data.instant.details.wind_speed -%}
  {%- assign now_symbol = now.data.next_1_hours.summary.symbol_code -%}
  {%- if now_symbol == nil -%}{%- assign now_symbol = now.data.next_6_hours.summary.symbol_code -%}{%- endif -%}
  {%- assign compass = "N,NE,E,SE,S,SW,W,NW" | split: "," -%}
  {%- assign point = now.data.instant.details.wind_from_direction | round: 0 | plus: 22 | divided_by: 45 | modulo: 8 -%}
  {%- assign now_dir = compass[point] -%}
  {%- assign updated = IDX_0.properties.meta.updated_at | date: "%s" | plus: tz -%}
{%- endif -%}

{%- comment -%} 6. Days. One pass over the series, because the array filters cannot
     reach a nested key (see the Liquid research). Each day becomes
     "epoch|max|min|symbol", joined with ";". Today is skipped: the hero and the
     hour strip already own it. {%- endcomment -%}
{%- assign days = "" -%}
{%- assign day_key = "" -%}
{%- assign day_epoch = 0 -%}
{%- assign day_max = -99 -%}
{%- assign day_min = 99 -%}
{%- assign day_symbol = "" -%}
{%- assign day_symbol_fixed = false -%}
{%- if forecast_ok -%}
  {%- for step in series -%}
    {%- assign block = step.data.next_6_hours -%}
    {%- if block.details.air_temperature_max == nil -%}{%- continue -%}{%- endif -%}
    {%- assign local = step.time | date: "%s" | plus: tz -%}
    {%- assign key = local | date: "%Y-%m-%d" -%}
    {%- if key != day_key -%}
      {%- if day_key != "" -%}
        {%- capture days -%}{{ days }}{{ day_epoch }}|{{ day_max }}|{{ day_min }}|{{ day_symbol }};{%- endcapture -%}
      {%- endif -%}
      {%- assign day_key = key -%}
      {%- assign day_epoch = local -%}
      {%- assign day_max = block.details.air_temperature_max -%}
      {%- assign day_min = block.details.air_temperature_min -%}
      {%- assign day_symbol = block.summary.symbol_code -%}
      {%- assign day_symbol_fixed = false -%}
    {%- else -%}
      {%- if block.details.air_temperature_max > day_max -%}
        {%- assign day_max = block.details.air_temperature_max -%}
      {%- endif -%}
      {%- if block.details.air_temperature_min < day_min -%}
        {%- assign day_min = block.details.air_temperature_min -%}
      {%- endif -%}
    {%- endif -%}
    {%- comment -%} The day gets the symbol of its first afternoon block, so a
         daytime glyph stands for the day. {%- endcomment -%}
    {%- unless day_symbol_fixed -%}
      {%- assign hour = local | date: "%H" | times: 1 -%}
      {%- if hour >= 12 -%}
        {%- assign day_symbol = block.summary.symbol_code -%}
        {%- assign day_symbol_fixed = true -%}
      {%- endif -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- if day_key != "" -%}
    {%- capture days -%}{{ days }}{{ day_epoch }}|{{ day_max }}|{{ day_min }}|{{ day_symbol }};{%- endcapture -%}
  {%- endif -%}
{%- endif -%}
{%- assign day_list = days | split: ";" -%}

{%- comment -%} 7. The next 12 hours, in 2-hour steps. Packed as
     "epoch|temperature|symbol|precipitation|unit", joined with ";", the same
     shape as the day list.

     The unit is the exact text that follows the number, its own spacing
     included: "%" for a probability, " mm" for an amount. MET gives the
     probability in the Nordic area only, so both the choice and the way it is
     written belong here, with the payload, and not in a layout. When the
     language table of #16 arrives, this is the line it replaces.

     Every read of the MET payload lives in this file. A layout names
     now_*, warn_*, hour_list and day_list, never a MET field. {%- endcomment -%}
{%- assign hours = "" -%}
{%- if forecast_ok -%}
  {%- for column in (1..6) -%}
    {%- assign index = column | times: 2 -%}
    {%- assign step = series[index] -%}
    {%- if step == nil -%}{%- continue -%}{%- endif -%}
    {%- assign epoch = step.time | date: "%s" | plus: tz -%}
    {%- assign temperature = step.data.instant.details.air_temperature | round: 0 -%}
    {%- assign symbol = step.data.next_1_hours.summary.symbol_code -%}
    {%- if symbol == nil -%}
      {%- assign symbol = step.data.next_6_hours.summary.symbol_code -%}
    {%- endif -%}
    {%- assign chance = step.data.next_1_hours.details.probability_of_precipitation -%}
    {%- assign amount = step.data.next_1_hours.details.precipitation_amount -%}
    {%- assign rain = "" -%}
    {%- assign unit = "" -%}
    {%- if chance -%}
      {%- assign rain = chance | round: 0 -%}
      {%- assign unit = "%" -%}
    {%- elsif amount -%}
      {%- assign rain = amount | round: 1 -%}
      {%- assign unit = " mm" -%}
    {%- endif -%}
    {%- capture hours -%}{{ hours }}{{ epoch }}|{{ temperature }}|{{ symbol }}|{{ rain }}|{{ unit }};{%- endcapture -%}
  {%- endfor -%}
{%- endif -%}
{%- assign hour_list = hours | split: ";" -%}
