{%- comment -%}
  Half horizontal, 800x240: a banner, about 144px of content height.

  Wide and shallow, so everything sits side by side and nothing stacks except
  the warning strip, which has to cross the top to be a warning at all. Three
  zones in one row: hero, hours, days.

  Cut against the full screen:
    - the feels-like and wind line moves under the hero temperature, small.
    - the day band drops to four columns, maximum over minimum. Side by side,
      "18/16" collides with its neighbour at 66px.
    - a vertical rule separates the three zones. Without it the six hour columns
      and the four day columns read as one strip of ten.

  `divider--v` is a real framework class: it ships in plugins.css for the
  pinned 3.3.0 and for latest. `w--[2px]` beside it is deliberate, not padding.
  The class computes to 0.97px wide, and at that width whether it survives a
  1-bit render depends on where its sub-pixel x position falls: two identical
  rules on this screen behaved differently until the width was forced to a
  whole device pixel. Do not replace it with a 1px div.
    - the warning area name goes, as on the half vertical.

  Nothing changes count when a warning appears. On the taller layouts the
  band's space becomes forecast detail (#13), but here there is no room to add
  a column that would still be readable, so the zones simply breathe less.
{%- endcomment -%}

{% if forecast_ok == false %}
  <div class="layout layout--col layout--center">
    <span class="value value--medium">No forecast data</span>
    <span class="label label--small">MET Norway did not answer the last poll</span>
  </div>
{% else %}
  <div class="layout layout--col gap--small">

    {% if warn_count > 0 %}
      <div class="flex flex--row flex--center-y gap--small bg--black px--2">
        <span class="label label--small text--white text--uppercase">&#9888; {{ warn_level }}</span>
        <span class="label label--small text--white" data-clamp="1">{{ warn_event }}</span>
        {% if warn_count > 1 %}
          <div class="grow"></div>
          <span class="label label--small text--white">+{{ warn_count | minus: 1 }}</span>
        {% endif %}
      </div>
    {% elsif warnings_ok == false %}
      <div class="flex flex--row px--2">
        <span class="label label--xsmall label--outline">Warnings unavailable</span>
      </div>
    {% endif %}

    <div class="grid stretch-y">

      {%- comment -%} Hero. {%- endcomment -%}
      <div class="col--span-3 flex flex--col flex--center-x flex--center-y gap--none">
        <div class="flex flex--row flex--center-y gap--small">
          {% render "weather_icon", code: now_symbol, box: "w--[52px] h--[52px] lg:w--[88px] lg:h--[88px]" %}
          <span class="value value--large lg:value--xxlarge value--tnums" data-fit-value="true">{{ now_temp | round: 0 }}&deg;</span>
        </div>
        <span class="label label--xsmall lg:label--small">Feels {{ now_feels | round: 0 }}&deg; &middot; {{ now_wind | round: 0 }} m/s {{ now_dir }}</span>
      </div>

      {%- comment -%} The next twelve hours. {%- endcomment -%}
      <div class="col--span-5 flex flex--row gap--small">
        <div class="divider divider--v w--[2px]"></div>
        <div class="grid grid--cols-6 grow">
        {% for record in hour_list %}
          {% assign hour = record | split: "|" %}
          <div class="flex flex--col flex--center-x gap--none">
            <span class="label label--xsmall lg:label--small">{{ hour[0] | times: 1 | date: "%H" }}</span>
            {% render "weather_icon", code: hour[2], box: "w--[30px] h--[30px] lg:w--[52px] lg:h--[52px]" %}
            <span class="value value--xsmall lg:value--medium value--tnums">{{ hour[1] }}&deg;</span>
            <span class="label label--xsmall lg:label--small">{% if hour[3] %}{{ hour[3] }}{{ hour[4] }}{% else %}&nbsp;{% endif %}</span>
          </div>
        {% endfor %}
        </div>
      </div>

      {%- comment -%} The next four days. {%- endcomment -%}
      <div class="col--span-4 flex flex--row gap--small">
        <div class="divider divider--v w--[2px]"></div>
        <div class="grid grid--cols-4 grow">
        {% for record in day_list limit: 4 %}
          {% assign day = record | split: "|" %}
          <div class="flex flex--col flex--center-x gap--none">
            <span class="label label--xsmall lg:label--small text--uppercase">{% if forloop.first %}Today{% else %}{{ day[0] | times: 1 | date: "%a" }}{% endif %}</span>
            {% render "weather_icon", code: day[3], box: "w--[30px] h--[30px] lg:w--[52px] lg:h--[52px]" %}
            <span class="value value--xsmall lg:value--medium value--tnums">{{ day[1] | round: 0 }}&deg;</span>
            <span class="label label--xsmall lg:label--small">{{ day[2] | round: 0 }}&deg;</span>
          </div>
        {% endfor %}
        </div>
      </div>

    </div>
  </div>
{% endif %}

<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" />
  <span class="title">{{ place | default: "Forecast" }}</span>
  <span class="instance">MET Norway &middot; CC BY 4.0</span>
</div>
